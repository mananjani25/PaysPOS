<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="model"
            type="com.pays.pos.data.entities.Modifier" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_6sdp"
        android:paddingTop="@dimen/_2sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingBottom="@dimen/_2sdp"
        android:weightSum="3">

        <TextView
            android:id="@+id/txtName"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/color88"
            android:textSize="@dimen/_6mdpi" />

        <TextView
            android:id="@+id/txtQuantity"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_weight="0.5"
            android:gravity="center"
            android:visibility="invisible"
            android:text="@{``+model.itemQuantity}"
            android:textColor="@color/color88"
            android:textSize="@dimen/_6mdpi" />

        <TextView
            android:id="@+id/txtEachQntPrice"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_weight="0.5"
            android:visibility="visible"
            android:gravity="end"
            android:text="@{@string/symbole +``+String.format(@string/format,model.price)}"
            android:textColor="@color/color88"
            android:textSize="@dimen/_6mdpi" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRate"
                style="@style/CustomFontRegularStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:gravity="end"
                android:visibility="visible"
                android:textColor="@color/color88"
                android:textSize="@dimen/_6mdpi" />
            <TextView
                android:id="@+id/tvRateCash"
                style="@style/CustomFontRegularStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="0.5"
                android:visibility="gone"
                android:gravity="end"
                android:textColor="@color/color88"
                android:textSize="@dimen/_6mdpi" />

            <TextView
                android:id="@+id/tvRateCard"
                style="@style/CustomFontRegularStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="0.5"
                android:visibility="gone"
                android:gravity="end"
                android:textColor="@color/color88"
                android:textSize="@dimen/_6mdpi" />
        </LinearLayout>

    </LinearLayout>

</layout>