<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="model"
            type="com.android.pos.data.entities.Modifier" />
    </data>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_2sdp"
        android:orientation="vertical"
        android:paddingStart="@dimen/_2sdp"
        android:paddingTop="@dimen/_5sdp"
        android:paddingEnd="@dimen/_2sdp"
        android:paddingBottom="@dimen/_5sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/edtName"
            style="@style/CustomFontSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center"
            android:clickable="false"
            android:duplicateParentState="true"
            android:text="@{model.name}"
            android:textColor="@{model.isChecked ? @color/white: @color/viewTextColor}"
            android:textSize="@dimen/_6mdpi"
            tools:text="Modifier one" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/edtPrice"
            style="@style/CustomFontSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:gravity="start"
            android:hint="@string/_0_00"
            android:paddingTop="@dimen/_3sdp"
            android:clickable="false"
            android:duplicateParentState="true"
            android:text="@{@string/symbole +``+String.format(@string/format,model.price)}"
            android:textColor="@{model.isChecked ? @color/white: @color/viewTextColor}"
            android:textSize="@dimen/_5mdpi"
            android:alpha="0.8"
            android:visibility="visible" />
    </androidx.appcompat.widget.LinearLayoutCompat>


</layout>