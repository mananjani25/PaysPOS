<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.pays.pos.ui.fragments.openorder.OpenOrderCustomerViewModel" />
    </data>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_6sdp"
                app:srcCompat="@drawable/ic_cancel_black"
                />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/_4sdp"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                tools:text="Select Order Type" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtSave"
                style="@style/CustomFontSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center"
                android:background="@drawable/button_action_hover"
                android:gravity="center"
                android:paddingStart="@dimen/_15sdp"
                android:paddingTop="@dimen/_7sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:text="@string/save"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                tools:ignore="RelativeOverlap" />

        </RelativeLayout>

        <include layout="@layout/divider" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_35sdp"
            android:layout_marginEnd="@dimen/_35sdp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_search" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/etSearch"
                style="@style/CustomFontRegularStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:hint="@string/search_existing_customer_details"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/txtColor"
                android:textColorHint="@color/hintColor"
                android:textSize="@dimen/_5mdpi" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <include layout="@layout/divider" />

        <ScrollView
            android:id="@+id/scrollViewCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            tools:ignore="ScrollViewCount">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_30sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_30sdp"
                    android:orientation="vertical"
                    android:visibility="visible">



                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/edt_border_light_gray"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="1dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtPickup"
                            style="@style/CustomFontBold"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/button_action_hover"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/pick_up"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtDelivery"
                            style="@style/CustomFontBold"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/bg_color"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/delivery"
                            android:textAllCaps="true"
                            android:textColor="@color/txtColor"
                            android:textSize="@dimen/_5mdpi" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/edt_border_light_gray"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="1dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtCustomerDetails"
                            style="@style/CustomFontBold"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/button_action_hover"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/customer_details"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/txtDeliveryAddress"
                            style="@style/CustomFontBold"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/bg_color"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/delivery_address"
                            android:textAllCaps="true"
                            android:textColor="@color/txtColor"
                            android:textSize="@dimen/_5mdpi" />

                    </androidx.appcompat.widget.LinearLayoutCompat>


                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/llCustomerDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edt_border_light_gray"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtFirstName"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:digits="@string/character_String"
                            android:hint="@string/first_name"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords|textVisiblePassword"
                            android:padding="@dimen/_5sdp"
                            android:text="@={viewModel.addCustomerDetails.data.first_name}"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtLastName"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:digits="@string/character_String"
                            android:hint="@string/last_name_"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords|textVisiblePassword"
                            android:padding="@dimen/_5sdp"
                            android:text="@={viewModel.addCustomerDetails.data.last_name}"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"

                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />

                        <com.santalu.maskedittext.MaskEditText
                            android:id="@+id/edtPhoneNo"
                            style="@style/CustomFontMediumStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="@string/mobile_number"
                            android:inputType="number"
                            android:maxLength="20"
                            android:padding="@dimen/_5sdp"
                            android:text="@={viewModel.phoneNo}"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi"
                            app:met_mask="(###) ###-####" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtEmail"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/tv_hint_email_"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords|textVisiblePassword"
                            android:padding="@dimen/_5sdp"
                            android:text="@={viewModel.addCustomerDetails.data.email}"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi"

                            />

                        <include layout="@layout/divider" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtCompany"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/company"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords|textVisiblePassword"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/edtDate"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/date"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/edtTime"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/time"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtNote"
                            style="@style/CustomFontMediumStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:background="@null"
                            android:gravity="top"
                            android:hint="@string/add_note"
                            android:inputType="textMultiLine"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hintColor"
                            android:textSize="@dimen/_5mdpi"
                            android:visibility="gone" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:layout_marginBottom="@dimen/_20sdp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/btnClearCustomer"
                                style="@style/CustomFontBold"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:background="@drawable/button_action_hover"
                                android:gravity="center"
                                android:padding="@dimen/_5sdp"
                                android:text="@string/clear"
                                android:textColor="@color/txtColor"
                                android:textSize="@dimen/_5mdpi"
                                app:textAllCaps="false" />


                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/btnCancelCustomer"
                                style="@style/CustomFontBold"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:background="@drawable/button_action_hover"
                                android:gravity="center"
                                android:padding="@dimen/_5sdp"
                                android:text="@string/tv_cancel"
                                android:textColor="@color/txtColor"
                                android:textSize="@dimen/_5mdpi"
                                android:visibility="visible"
                                app:textAllCaps="false" />

                        </androidx.appcompat.widget.LinearLayoutCompat>


                    </androidx.appcompat.widget.LinearLayoutCompat>


                </androidx.appcompat.widget.LinearLayoutCompat>


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llDeliveryAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_30sdp"
                    android:layout_marginEnd="@dimen/_30sdp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!--  <androidx.recyclerview.widget.RecyclerView
                          android:id="@+id/rvAddresses"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:orientation="vertical"
                          app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                          tools:listitem="@layout/view_customer_address" />

  -->


                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:orientation="vertical">

                            <Spinner
                                android:id="@+id/spDelivery"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/background_square_border_grey"
                                android:theme="@style/SpinnerTheme" />

                            <AutoCompleteTextView
                                android:id="@+id/edtStreet"
                                style="@style/CustomFontSemiBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/background_square_border_grey"
                                android:hint="@string/street"
                                android:imeOptions="actionNext"
                                android:inputType="textNoSuggestions"
                                android:padding="@dimen/_5sdp"
                                android:textColor="@color/txtColor"
                                android:textColorHint="@color/hint_color_"
                                android:textSize="@dimen/_5mdpi" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/edtSuite"
                                style="@style/CustomFontMediumStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/background_square_border_grey"
                                android:hint="@string/apt_suite"
                                android:inputType="textNoSuggestions"
                                android:padding="@dimen/_5sdp"
                                android:textColor="@color/txtColor"
                                android:textColorHint="@color/hint_color_"
                                android:textSize="@dimen/_5mdpi" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="3">


                                <androidx.appcompat.widget.AppCompatEditText
                                    android:id="@+id/edtCity"
                                    style="@style/CustomFontSemiBold"
                                    android:layout_width="0sp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/background_square_border_grey"
                                    android:hint="@string/city"
                                    android:inputType="textNoSuggestions"
                                    android:padding="@dimen/_5sdp"
                                    android:textColor="@color/txtColor"
                                    android:textColorHint="@color/hint_color_"
                                    android:textSize="@dimen/_5mdpi" />

                                <androidx.appcompat.widget.AppCompatEditText
                                    android:id="@+id/edtState"
                                    style="@style/CustomFontSemiBold"
                                    android:layout_width="0sp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/background_square_border_grey"
                                    android:hint="@string/state"
                                    android:inputType="textNoSuggestions"
                                    android:padding="@dimen/_5sdp"
                                    android:textColor="@color/txtColor"
                                    android:textColorHint="@color/hint_color_"
                                    android:textSize="@dimen/_5mdpi" />

                                <androidx.appcompat.widget.AppCompatEditText
                                    android:id="@+id/edtZip"
                                    style="@style/CustomFontSemiBold"
                                    android:layout_width="0sp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/background_square_border_grey"
                                    android:hint="@string/zip"
                                    android:inputType="textNoSuggestions"
                                    android:padding="@dimen/_5sdp"
                                    android:textColor="@color/txtColor"
                                    android:textColorHint="@color/hint_color_"
                                    android:textSize="@dimen/_5mdpi" />


                            </LinearLayout>


                        </androidx.appcompat.widget.LinearLayoutCompat>


                    </androidx.appcompat.widget.LinearLayoutCompat>


                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnClearDelivery"
                            style="@style/CustomFontBold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_border_gray"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/clear"
                            android:textColor="@color/txtColor"
                            android:textSize="@dimen/_5mdpi"
                            app:textAllCaps="false" />


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnCancelDelivery"
                            style="@style/CustomFontBold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_border_gray"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/tv_cancel"
                            android:textColor="@color/txtColor"
                            android:textSize="@dimen/_5mdpi"
                            android:visibility="visible"
                            app:textAllCaps="false" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>


        </ScrollView>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llBillingAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_35sdp"
            android:layout_marginEnd="@dimen/_35sdp"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical">

                <TextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/billing_address"
                    android:textColor="@color/viewTextColor"
                    android:textSize="@dimen/_6mdpi" />

                <include layout="@layout/divider" />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="vertical">

                    <Spinner
                        android:id="@+id/spBill"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/background_square_border_grey"
                        android:theme="@style/SpinnerTheme" />

                    <AutoCompleteTextView
                        android:id="@+id/edtStreetBill"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_square_border_grey"
                        android:hint="@string/street"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:padding="@dimen/_5sdp"

                        android:textColor="@color/txtColor"
                        android:textColorHint="@color/hint_color_"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edtSuiteBill"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_square_border_grey"
                        android:hint="@string/apt_suite"
                        android:inputType="textNoSuggestions"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/txtColor"
                        android:textColorHint="@color/hint_color_"
                        android:textSize="@dimen/_5mdpi" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtCityBill"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/city"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtStateBill"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/state"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtZipBill"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/zip"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />


                    </LinearLayout>


