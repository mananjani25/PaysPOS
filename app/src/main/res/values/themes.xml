<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.POSAndroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

    </style>

    <style name="DialogWidthTheme" parent="Base.Theme.AppCompat.Dialog">
        <item name="android:windowMinWidthMajor">50%</item>
        <item name="android:windowMinWidthMinor">50%</item>
    </style>

    <style name="SpinnerTheme">
        <item name="android:textColor">@color/txt_color_blue</item>
        <item name="android:textSize">@dimen/_6mdpi</item>
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
    </style>

    <style name="SpinnerTheme1">
        <item name="android:textColor">@color/txt_color_blue</item>
        <item name="android:textSize">@dimen/_6mdpi</item>
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
        <item name="android:background">@drawable/border_spiner</item>
    </style>

    <style name="SpinnerThemeDarkMode">
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_8mdpi</item>
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
    </style>

    <style name="CustomFontRegularStyle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_regular</item>
    </style>

    <style name="CustomFontMediumStyle" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
    </style>

    <style name="CustomFontSemiBold" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_semibold</item>
    </style>

    <style name="CustomFontHeavy" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_heavy</item>

    </style>

    <style name="CustomFontLight" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_light</item>
    </style>



    <style name="CustomFontBold" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_bold</item>
    </style>

    <style name="NavigationTheme" parent="Theme.POSAndroid">
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="listPreferredItemHeightSmall">@dimen/_25sdp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>

    </style>

    <style name="DrawerItem" parent="Widget.AppCompat.ActionButton">
        <item name="android:textSize">@dimen/_6mdpi</item>
        <item name="fontFamily">@font/sf_pro_display_bold</item>
        <item name="android:fontFamily">@font/sf_pro_display_bold</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:textColor">@color/drawer_item_text_color_selector</item>
        <item name="background">@null</item>
        <item name="backgroundColor">@null</item>


        <!--<item name="android:paddingTop">30dp</item>
        <item name="android:paddingBottom">30dp</item>-->
    </style>

    <style name="MyTabLayout" parent="Base.Widget.Design.TabLayout">
        <item name="tabPaddingStart">10dp</item>
        <item name="tabPaddingEnd">10dp</item>
        <item name="tabIndicatorColor">@color/txtColor</item>
        <item name="tabIndicatorHeight">1dp</item>
        <item name="tabGravity">fill</item>
        <item name="fontFamily">@font/sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/_7mdpi</item>

    </style>

    <style name="MyTabTextAppearance" parent="TextAppearance.AppCompat">
        <item name="textAllCaps">false</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
        <item name="fontFamily">@font/sf_pro_display_semibold</item>

    </style>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        ...
        <!-- Active thumb color & Active track color(30% transparency) -->
        <!--  <item name="colorControlActivated">@color/btnColorDark</item>-->
        <item name="trackColorActive">@color/btnColorDark</item>
        <!-- Inactive thumb color -->
        <item name="colorSwitchThumbNormal">@color/boxColor</item>
        <!-- Inactive track color(30% transparency) -->
        <item name="android:colorForeground">@color/boxColor</item>
        ...
    </style>

    <style name="ThemePrinterSwitch" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorControlActivated">@color/btnColor</item>
        <!-- Inactive thumb color -->
        <!--  <item name="colorSwitchThumbNormal">@color/switchThumb</item>-->
        <item name="thumbColor">@color/switch_thumb_selector</item>

        <!-- Inactive track color(30% transparency) -->
        <item name="android:colorForeground">@color/boxColor</item>

    </style>

    <style name="PopupMenuOverlapAnchor" parent="@style/Theme.AppCompat.Light">
        <item name="android:overlapAnchor">true</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
    </style>

    <style name="DayBreakDialogTheme" parent="@android:style/Theme.Dialog">
        <item name="android:layout_width">335dp</item>
        <item name="android:windowMinWidthMajor">335dp</item>
        <item name="android:windowMinWidthMinor">335dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme_Dialog" parent="android:Theme.Holo.Dialog">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="Theme.App" parent="Theme.MaterialComponents">
        ...
        <item name="colorPrimary">@color/colorRed</item>
        <item name="colorOnPrimary">@color/colorRed</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent
        </item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">cut</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>


    <style name="DialogTheme" parent="AppTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="noAnimTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
    </style>


</resources>