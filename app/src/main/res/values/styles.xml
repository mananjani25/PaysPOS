<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ReportHeaderStyle" parent="CustomFontSemiBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginLeft">@dimen/_5sdp</item>
        <item name="android:layout_marginRight">@dimen/_5sdp</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="ReportHeaderButtonStyle" parent="ReportHeaderStyle">
        <item name="android:padding">@dimen/_4sdp</item>
    </style>

    <style name="ReportTitleStyle" parent="CustomFontMediumStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/background_timesheet</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/_5sdp</item>
        <item name="android:paddingBottom">@dimen/_5sdp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_6mdpi</item>
    </style>

    <style name="ReportRecyclerViewstyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ReportItemText" parent="CustomFontMediumStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="ReportItemHeaderText" parent="CustomFontSemiBold">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>
</resources>