<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ReportHeaderStyle" parent="CustomFontSemiBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginLeft">@dimen/_5sdp</item>
        <item name="android:layout_marginRight">@dimen/_5sdp</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="ReportHeaderButtonStyle" parent="ReportHeaderStyle">
        <item name="android:padding">@dimen/_4sdp</item>
    </style>

    <style name="ReportTitleStyle" parent="CustomFontSemiBold">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/background_drawer_button_green</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/_5sdp</item>
        <item name="android:paddingBottom">@dimen/_5sdp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_6mdpi</item>
    </style>

    <style name="ReportRecyclerViewstyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ReportItemText" parent="CustomFontMediumStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="WrapForReport" parent="CustomFontRegularStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="HistoryItemText" parent="ReportItemText">
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">@dimen/_5sdp</item>
        <item name="android:paddingEnd">@dimen/_5sdp</item>
        <item name="android:paddingTop">@dimen/_5sdp</item>
        <item name="android:paddingBottom">@dimen/_5sdp</item>
        <item name="android:gravity">start</item>
        <item name="android:background">@drawable/background_white_with_border</item>
    </style>

    <style name="ReportItemHeaderText" parent="CustomFontBold">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="HistoryItemHeaderText" parent="ReportItemHeaderText">
        <item name="android:paddingStart">@dimen/_5sdp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingEnd">@dimen/_5sdp</item>
        <item name="android:paddingTop">@dimen/_5sdp</item>
        <item name="android:paddingBottom">@dimen/_5sdp</item>
        <item name="android:gravity">start</item>
        <item name="android:background">@drawable/background_gray_with_border</item>
    </style>

    <style name="OrderIdStyle">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PaymentStatusStyle">
        <item name="android:textColor">@color/hint_color</item>
    </style>

    <style name="DateStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="TimeStyle">
        <item name="android:textColor">@color/hint_color</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="CustomerNameStyle">
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:textSize">@dimen/_6mdpi</item>
    </style>

    <style name="LoyaltyPointStyle">
        <item name="android:textColor">@color/txt_color_blue</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
    </style>

    <style name="PopUpCheckBox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:button">@drawable/bg_checkbox</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="PopUpLabel" parent="CustomFontMediumStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/_3sdp</item>
        <item name="android:textColor">@color/drawerBack</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="PopUpValue" parent="CustomFontSemiBold">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/_3sdp</item>
        <item name="android:textColor">@color/drawerBack</item>
        <item name="android:textSize">@dimen/_5mdpi</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="MaterialAlertDialogText" parent="@style/MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_7mdpi</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/bg_color</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="colorAccent">@color/txtColor</item>
        <item name="android:textColorAlertDialogListItem">@color/txtColor</item>
    </style>

    <style name="passcodeviewStyle">
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_height">@dimen/_30sdp</item>
        <item name="android:layout_width">@dimen/_30sdp</item>
        <item name="android:background">@drawable/passcode_viewunselected</item>
    </style>

    <style name="keypadManualSaleviewStyle">
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">3</item>
        <item name="android:layout_margin">@dimen/_5sdp</item>
        <item name="android:background">@drawable/background_txt_selector</item>

    </style>

    <style name="ResetStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_6sdp</item>
        <item name="android:textColor">@color/txtColor</item>
        <item name="android:fontFamily">@font/sf_pro_display_regular</item>
        <item name="android:textSize">@dimen/_6mdpi</item>
    </style>


</resources>