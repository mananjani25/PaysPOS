<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>

                <shape>

                    <solid android:color="#FFFFFF" />

                    <stroke android:width="1dp" android:color="@color/colorNewBorder" />

                    <corners android:radius="0dp" />

                    <padding android:bottom="0dip" android:left="0dip" android:right="10dip" android:top="0dip" />

                </shape>
            </item>
            <item>
                <bitmap android:gravity="right|center" android:src="@android:drawable/arrow_down_float" android:tint="@color/color96" />
            </item>
        </layer-list>
    </item>

</selector>




