<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.POSAndroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/bg_color</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/bg_color</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

        <item name="android:windowSplashScreenBrandingImage">@drawable/pays_logo_transparent</item>

    </style>

    <style name="CustomFontRegularStyle" parent="@android:style/TextAppearance.Medium">
        <item name="android:fontFamily">@font/sf_pro_display_regular</item>
    </style>

    <style name="CustomFontMediumStyle" parent="@android:style/TextAppearance.Medium">
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
    </style>

    <style name="CustomFontSemiBold" parent="@android:style/TextAppearance.Medium">
        <item name="android:fontFamily">@font/sf_pro_display_semibold</item>
    </style>

    <style name="CustomFontLight" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_light</item>
    </style>

    <style name="CustomFontBold" parent="@android:style/TextAppearance.Medium">
        <item name="android:fontFamily">@font/sf_pro_display_bold</item>
    </style>

    <style name="CustomFontHeavy" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sf_pro_display_heavy</item>

    </style>


</resources>