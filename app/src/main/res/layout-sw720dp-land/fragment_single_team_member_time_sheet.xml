<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.fragments.settings.teamrole.TeamMemberTimeSheetFragment"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.pays.pos.ui.fragments.settings.teamrole.TeamMemberSheetViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        android:orientation="vertical">

        <include
            android:id="@+id/includeView"
            layout="@layout/layout_team_member_time_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            bind:includeLayoutViewModel="@{viewModel}" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_color"
            android:orientation="vertical"
            android:padding="@dimen/_7sdp">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmployeeName"
                style="@style/CustomFontBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true"
                tools:text="John Smith Time Sheet" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmployeeId"
                style="@style/CustomFontMediumStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:gravity="center"
                android:padding="@dimen/_2sdp"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                tools:text="John Smith Time Sheet" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_timesheet"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_4sdp">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_weight="0.5"
                android:gravity="center"
                android:text="@string/employee_id"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="center"
                android:text="@string/tv_clock_in_date_time"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="center"
                android:text="@string/tv_clock_out_date_time"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tv_wage"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tv_break"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                android:visibility="gone"
                app:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tv_working_hours"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tv_total_wage"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tv_action"
                android:visibility="gone"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="true" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSingleTimeSheet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/view_single_member_item_timesheet" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEmployeeTotalHours"
            style="@style/CustomFontSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_1sdp"
            android:layout_weight="0.5"
            android:gravity="center"
            android:textColor="@color/btnColorDark"
            android:textSize="@dimen/_6mdpi"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEmployeeTotalWages"
            style="@style/CustomFontSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:layout_weight="0.5"
            android:gravity="center"
            android:textColor="@color/btnColorDark"
            android:textSize="@dimen/_6mdpi"
            android:textStyle="bold" />


    </LinearLayout>
</layout>