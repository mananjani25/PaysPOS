<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="itemSheetModel"
            type="com.android.pos.data.model.responseModel.GetTransactionListResponse.Data.Payment" />

        <variable
            name="viewModel"
            type="com.android.pos.ui.fragments.transactions.TransactionViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{() -> viewModel.transactionId(itemSheetModel)}"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_5sdp"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDate"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/text_size_medium"
                    tools:text="@string/date"
                    android:paddingLeft="@dimen/_25sdp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTime"
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:gravity="center"
                    android:textColor="@color/colorC4"
                    android:textSize="@dimen/text_size_normal"
                    tools:text="@string/date"
                    android:paddingLeft="@dimen/_25sdp"/>

            </LinearLayout>


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{itemSheetModel.orderDetails.orderTypeName}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/text_size_medium"
                app:textAllCaps="true"
                tools:text="@string/date" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTotalAmount"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:text="@{@string/symbole +` `+String.format(@string/format,itemSheetModel.totalAmount) }"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/text_size_medium"
                    app:textAllCaps="true"
                    tools:text="$0.00"
                    android:paddingLeft="@dimen/_18sdp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPaymentType"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:text="@{itemSheetModel.paymentType}"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/text_size_medium"
                    app:textAllCaps="true"
                    tools:text="$0.00"
                    android:paddingLeft="@dimen/_18sdp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvRefundedAmount"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:textColor="@color/colorRed"
                    android:textSize="@dimen/text_size_medium"
                    tools:text="$0.00"
                    android:paddingLeft="@dimen/_18sdp"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtTip"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{@string/symbole +` `+String.format(@string/format,itemSheetModel.tips)}"
                android:textColor="@color/btnColor"
                android:textSize="@dimen/text_size_medium"
                android:layout_gravity="center_vertical"
                tools:text="$0.00"
                android:paddingLeft="@dimen/_22sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtCustomerName"
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/text_size_medium"
                tools:text="John Smith"
                android:paddingLeft="@dimen/_22sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{itemSheetModel.employeeRoleName}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                android:visibility="gone"
                tools:text="John Smith" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{itemSheetModel.employeeName}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                tools:text="John Smith" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtTransactionId"
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:text="@{``+itemSheetModel.orderId}"
                    android:textColor="@color/txtColor"

                    android:textSize="@dimen/text_size_medium"
                    tools:text="AXDAWEDWD"
                    android:paddingLeft="@dimen/_2sdp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="center"
                    android:text="@{`#`+itemSheetModel.orderDetails.receiptId}"
                    android:textColor="@color/txtColor"
                    android:alpha="0.6"
                    android:textSize="@dimen/text_size_medium"
                    tools:text="$AAAAAAA"
                    android:paddingLeft="@dimen/_2sdp"

                    />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="@{itemSheetModel.terminalName}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/text_size_medium"
                android:visibility="visible"
                tools:text="terminal name"
                android:paddingLeft="@dimen/_25sdp"/>

        </LinearLayout>

    </LinearLayout>
</layout>