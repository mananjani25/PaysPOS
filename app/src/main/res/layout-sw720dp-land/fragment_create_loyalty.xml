<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="createLoyaltyFragment"
            type="com.android.pos.ui.fragments.settings.loyaltypoints.CreateLoyaltyFragment" />

        <variable
            name="viewModel"
            type="com.android.pos.ui.fragments.settings.loyaltypoints.LoyaltyPointViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_color"
            android:orientation="vertical">

            <include
                android:id="@+id/header"
                layout="@layout/view_header_toolbar" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_60sdp"
                android:layout_marginEnd="@dimen/_60sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatEditText
                    style="@style/CustomFontSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:hint="@string/loyalty_name"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords|textVisiblePassword"
                    android:padding="@dimen/_7sdp"
                    android:text="@={viewModel.loyaltyName}"
                    android:textColor="@color/txtColor"
                    android:textColorHint="@color/hintColor"
                    android:textSize="@dimen/text_size_medium" />

                <TextView
                    style="@style/CustomFontRegularStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="@string/loyalty_value"
                    android:textAllCaps="true"
                    android:textColor="@color/txtColor"
                    android:textColorHint="@color/hintColor"
                    android:textSize="@dimen/text_size_normal"
                    android:paddingStart="@dimen/_7sdp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/view" />


                <CheckBox
                    style="@style/CustomFontRegularStyle"
                    android:id="@+id/swtCreateLoyalty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_value"
                    android:textColor="@color/txtColor"
                    android:paddingStart="@dimen/_5sdp"
                    android:textSize="@dimen/text_size_normal"
                    android:layout_marginTop="@dimen/_5sdp"

                    />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/view"
                    />

                <CheckBox
                    style="@style/CustomFontRegularStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/percentage_value"
                    android:textColor="@color/txtColor"
                    android:paddingStart="@dimen/_5sdp"
                    android:textSize="@dimen/text_size_normal"
                    android:layout_marginTop="@dimen/_5sdp"
                    />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/view"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_5sdp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tvSymbolDollar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_3sdp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:text="@string/symbole"
                            android:textColor="@color/viewTextColor"
                            android:textSize="@dimen/_5mdpi"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvSymbolPer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:text="@string/percentage_symbol"
                            android:textColor="@color/viewTextColor"
                            android:textSize="@dimen/_5mdpi"
                            android:visibility="gone" />

                        <androidx.appcompat.widget.AppCompatEditText
                            style="@style/CustomFontSemiBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="0%"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingTop="@dimen/_5sdp"
                            android:paddingBottom="@dimen/_5sdp"
                            android:text="@={``+viewModel.loyaltyAmount}"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hintColor"
                            android:textSize="@dimen/_5mdpi" />

                    </LinearLayout>

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/view" />

                <TextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:hint="@string/loyalty_target"
                    android:textAllCaps="true"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="@string/loyalty_target"
                    android:textColor="@color/black"
                    android:textColorHint="@color/hintColor"
                    android:textSize="@dimen/_5mdpi"
                    android:visibility="gone"/>

                <androidx.appcompat.widget.AppCompatEditText
                    style="@style/CustomFontSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_square_border_grey"
                    android:hint="@string/loyalty_target"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:padding="@dimen/_7sdp"
                    android:text="@={``+viewModel.loyaltyTarget}"
                    android:textColor="@color/txtColor"
                    android:textColorHint="@color/hintColor"
                    android:textSize="@dimen/text_size_medium"
                    android:layout_marginTop="@dimen/_10sdp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontRegularStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:gravity="start"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:text="@string/number_of_points_required_to_get_the_reward"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/_5mdpi"
                    app:textAllCaps="false"
                    android:layout_marginTop="@dimen/_5sdp"/>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>