<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="model"
            type="com.pays.pos.data.model.responseModel.PrinterResponse.Data.OrderTypes" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_light_edit_printer"

        android:orientation="horizontal"
        android:weightSum="5">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtPrintersLabel"
            style="@style/CustomFontMediumStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Printer Name 1"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_5mdpi" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/strokeColor" />

        <LinearLayout
            android:id="@+id/constraintCustomer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtCustomerReceipt"
                style="@style/CustomFontMediumStyle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="Customer Receipt"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@+id/viewLine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/viewLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/strokeColor"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtKitReceipt"
                style="@style/CustomFontMediumStyle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:gravity="start"
                android:paddingVertical="@dimen/_5sdp"
                android:text="Kitchen Receipt"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewLine" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/strokeColor" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/strokeColor" />

        <!--<androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/chBoxCustomerManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"

                app:layout_constraintBottom_toTopOf="@+id/viewLine1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/viewLine1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorNewBorder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <CheckBox
                android:id="@+id/chBoxKitchenManual"
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/viewLine1" />

        </androidx.constraintlayout.widget.ConstraintLayout>-->

        <View
            android:id="@+id/viewLine3"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/strokeColor"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/constraintCustomerChkbx"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/chBoxCustomerManual2"
                style="@style/AppTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:scaleX="0.7"
                android:scaleY="0.8"
                android:showText="false"
                android:thumb="@drawable/custom_thumb_printer_active_switch"
                android:visibility="visible"
                app:thumbTint="@color/switch_thumb_selector"
                app:track="@drawable/custom_switch_track_printer"
                app:trackTint="@color/switch_track_tint"
                tools:ignore="UseSwitchCompatOrMaterialXml" />


            <!--  <CheckBox
                  android:id="@+id/chBoxCustomerManual2"
                  android:layout_width="wrap_content"
                  android:layout_height="@dimen/_20sdp"
                  android:layout_gravity="center"
                  android:gravity="center" />-->

            <View
                android:id="@+id/viewLine2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/strokeColor"
                app:layout_constraintTop_toBottomOf="@+id/chBoxCustomerManual2" />


            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/chBoxKitchenManual2"
                style="@style/AppTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:scaleX="0.7"
                android:scaleY="0.8"
                android:showText="false"
                android:thumb="@drawable/custom_thumb_printer_active_switch"
                android:visibility="visible"
                app:thumbTint="@color/switch_thumb_selector"
                app:track="@drawable/custom_switch_track_printer"
                app:trackTint="@color/switch_track_tint"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <!-- <CheckBox
                 android:id="@+id/chBoxKitchenManual2"
                 android:layout_width="wrap_content"
                 android:layout_height="@dimen/_20sdp"
                 android:layout_gravity="center"

                 android:gravity="center" />-->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/strokeColor" />


        </LinearLayout>

    </LinearLayout>
</layout>