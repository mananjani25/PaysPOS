<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <RelativeLayout
        android:id="@+id/rlRoot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_23sdp"
        android:background="@color/bg_color"
        android:orientation="horizontal"
        >


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearFirst"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgDrawer"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingEnd="@dimen/_6sdp"
                android:paddingBottom="@dimen/_6sdp"
                android:src="@drawable/ic_menu_drawer" />

            <TextView
                android:id="@+id/txtKeypad"
                style="@style/CustomFontRegularStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_5sdp"
                android:text="@string/keypad"
                android:textAllCaps="true"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi" />

            <!-- <TextView
                android:id="@+id/txtDineIn"
                style="@style/CustomFontRegularStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_5sdp"
                android:text="DINE IN"
                android:textAllCaps="true"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                android:visibility="gone" />
-->
            <TextView
                android:id="@+id/txt_open_order"
                style="@style/CustomFontRegularStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_5sdp"
                android:text="@string/open_orders"
                android:textAllCaps="true"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi" />


            <LinearLayout
                android:id="@+id/linear_onlineorder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_online_order"
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="end"
                    android:paddingVertical="@dimen/_5sdp"
                    android:text="@string/all_orders"
                    android:textAllCaps="true"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_6mdpi" />

                <TextView
                    android:id="@+id/txt_badge_count"
                    android:layout_width="@dimen/_7sdp"
                    android:layout_height="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:background="@drawable/rounded_corner_textview_badge"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_3sdp"
                    android:visibility="gone" />

            </LinearLayout>


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_toStartOf="@id/linearSecond"
            android:layout_toEndOf="@id/linearFirst"
            android:gravity="center">

            <AutoCompleteTextView
                android:id="@+id/edtSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/_100sdp"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_20sdp"
                android:autoLink="all"
                android:maxLength="60"
                android:digits="@string/character_digits_String"
                android:singleLine="true"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:drawableStart="@drawable/ic_dashboard_serach"
                android:drawablePadding="@dimen/_5sdp"
                android:dropDownWidth="@dimen/_120sdp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_regular"
                android:gravity="start"
                android:hint="@string/search_by_item"
                android:imeOptions="actionDone"
                android:inputType="textVisiblePassword"
                android:lines="1"
                android:maxWidth="@dimen/_100sdp"
                android:maxLines="1"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/txtColor"
                android:textColorHint="@color/hint_color"
                android:textSize="@dimen/_7mdpi" />


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearSecond"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgCashdDrawer"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_toStartOf="@+id/imgSync"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/search"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/cashdrawer"
                android:visibility="gone"
                app:tint="@color/txtColor" />

            <ImageView
                android:id="@+id/imgSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/imgSearch"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/search"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_sync"
                android:visibility="visible"
                app:tint="@color/txtColor" />

            <ProgressBar
                android:id="@+id/syncProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="15.00dp"
                android:layout_marginHorizontal="0.00dp"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/txtTransaction"
                style="@style/CustomFontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:padding="@dimen/_5sdp"
                android:text="@string/transactions"
                android:textAllCaps="true"
                android:textColor="@color/btnColor"
                android:textSize="@dimen/_6mdpi" />




            <LinearLayout
                android:layout_marginEnd="@dimen/_5sdp"
                android:id="@+id/linear_switchUser"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/clock"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgswitch"

                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:contentDescription="@string/clock"
                    android:paddingVertical="@dimen/_5sdp"
                    android:src="@drawable/swipe_user_clock"
                    app:tint="@color/txtColor" />

                <TextView
                    android:id="@+id/txtUserName"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/_100sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_gravity="center"
                    android:textAllCaps="true"
                    android:textSize="@dimen/_6mdpi"
                    tools:text="ELEANOR RUSSELL" />
            </LinearLayout>

            <View
                android:visibility="visible"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:background="@color/txtColor" />

            <LinearLayout

                android:layout_marginEnd="@dimen/_5sdp"
                android:id="@+id/ivLock"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_20sdp"
                android:gravity="end"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/clock"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_2sdp"
                    android:contentDescription="@string/clock"
                    android:paddingVertical="@dimen/_5sdp"
                    android:src="@drawable/ic_clock_out"
                    app:tint="@color/txtColor" />

                <TextView
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAllCaps="true"
                    android:textSize="@dimen/_6mdpi"
                    android:textColor="@color/btnColor"
                    android:text="@string/tv_clock_out" />
            </LinearLayout>

            <ImageView
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_5sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_lock"
                app:tint="@color/txtColor" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </RelativeLayout>
</layout>