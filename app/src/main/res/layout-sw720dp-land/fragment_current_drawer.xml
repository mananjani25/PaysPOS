<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNoMoney"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center"
                android:src="@drawable/no_money" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/sf_pro_display_bold"
                android:text="@string/no_cash_drawer"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_7ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/sf_pro_display_regular"
                android:text="@string/cash_description"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_7ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/background_drawer_button"
                android:fontFamily="@font/sf_pro_display_bold"
                android:gravity="center"
                android:minWidth="@dimen/_180sdp"
                android:padding="@dimen/_5sdp"
                android:text="@string/turn_on_cash_management"
                android:textColor="@color/txt_color_blue"
                android:textSize="@dimen/_6ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@drawable/background_drawer_button"
                android:fontFamily="@font/sf_pro_display_bold"
                android:gravity="center"
                android:minWidth="@dimen/_180sdp"
                android:padding="@dimen/_5sdp"
                android:text="@string/other_drawers"
                android:textColor="@color/txt_color_blue"
                android:textSize="@dimen/_6ssp" />
        </LinearLayout>
    </ScrollView>

</layout>