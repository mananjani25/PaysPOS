<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:padding="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:tint="@color/drawable_ic_color"
            app:srcCompat="@mipmap/ic_left_arrow" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/CustomFontSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/lbl_add_value"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_7mdpi" />


        <TextView
            android:id="@+id/txtNext"
            style="@style/CustomFontBold"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_23sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_action_hover"
            android:gravity="center"
            android:paddingHorizontal="@dimen/padding_home_button"
            android:text="@string/tv_next"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/_7mdpi"
            android:visibility="visible" />


    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/view" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/_150sdp"
            android:orientation="vertical"
            android:paddingTop="@dimen/_4sdp"
            android:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/_10sdp"
                android:visibility="visible"
                android:layout_marginBottom="@dimen/_2sdp"
                android:background="@drawable/background_square_border_grey"
                android:padding="@dimen/_4sdp">

                <com.santalu.maskedittext.MaskEditText
                    android:id="@+id/edtGiftCardNumber"
                    style="@style/CustomFontBold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@null"
                    android:hint="@string/hint_enter_your_gift_card_number"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="15"
                    android:textColor="@color/btnColor"
                    android:textColorHint="@color/hint_color"
                    android:textSize="@dimen/_6sdp"
                    app:met_mask="####  ####" />

            </androidx.constraintlayout.widget.ConstraintLayout>

<!--
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:background="@drawable/background_square_border_grey"
                android:padding="@dimen/_4sdp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtAmount"
                    style="@style/CustomFontBold"
                    android:background="@null"
                    android:digits="0123456789"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"
                    android:maxLength="8"
                    android:editable="true"
                    android:enabled="true"
                    android:hint="@string/hint_enter_your_gift_card_amount"
                    android:textColor="@color/btnColor"
                    android:textColorHint="@color/txtColorGray"
                    android:textSize="@dimen/_6sdp"
                    tools:ignore="MissingConstraints" />

            </androidx.constraintlayout.widget.ConstraintLayout>-->

            <RelativeLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_18sdp"
                android:background="@drawable/background_square_border_grey"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:padding="@dimen/_4sdp">


                <TextView
                    android:id="@+id/edt1"
                    android:text="$"
                    style="@style/CustomFontBold"
                    android:textColor="@color/btnColor"
                    android:gravity="center_vertical"
                    android:textSize="@dimen/_6sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtAmount"
                    android:text="0.00"
                    android:layout_toEndOf="@+id/edt1"
                    android:gravity="center_vertical"
                    style="@style/CustomFontBold"
                    android:background="@null"
                    android:inputType="number"
                    android:editable="true"
                    android:maxLength="8"
                    android:enabled="true"
                    android:textColor="@color/btnColor"
                    android:textColorHint="@color/txtColorGray"
                    android:textSize="@dimen/_6sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>


            </RelativeLayout>


            <include
                android:id="@+id/llKeypad"
                layout="@layout/layout_discount_keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingLeft="@dimen/_5sdp"
                android:paddingRight="@dimen/_5sdp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>