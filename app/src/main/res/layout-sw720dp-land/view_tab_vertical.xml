<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <import type="android.view.View" />

        <variable
            name="model"
            type="com.android.pos.data.model.CategoryTabModel" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_tab_vertical">


        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1.9"
            android:gravity="center"
            android:padding="@dimen/_7sdp"
            android:text="@{model.title}"
            android:textColor="@{model.isSelected ? @color/txtColor : @color/drawerItemUnselected}"
            android:textSize="@dimen/_6mdpi"
            app:layout_constraintEnd_toStartOf="@+id/viewLine"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <View
            android:id="@+id/viewLine"
            android:layout_width="@dimen/_3sdp"
            android:layout_height="0sp"
            android:layout_gravity="end"
            android:background="@color/txtColor"
            android:gravity="end"
            android:visibility="@{model.isSelected ? View.VISIBLE : View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>