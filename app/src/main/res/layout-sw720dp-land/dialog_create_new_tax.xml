<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="createTaxFragment"
            type="com.android.pos.ui.fragments.settings.tax.CreateTax" />

        <variable
            name="viewModel"
            type="com.android.pos.ui.fragments.settings.tax.CreateTaxViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:srcCompat="@drawable/ic_cancel_black" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtTaxTitle"
                    style="@style/CustomFontSemiBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/tv_new_tax"
                    android:textSize="@dimen/_7mdpi" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtSave"
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="0.1"
                    android:background="@color/btnColor"
                    android:gravity="center"
                    android:onClick="@{() -> viewModel.submit()}"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/save"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_7mdpi" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/view" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_50sdp"
                android:layout_marginTop="@dimen/_25sdp"
                android:layout_marginEnd="@dimen/_50sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:orientation="vertical">


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:elevation="@dimen/_10sdp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/tv_enable_default_tax"
                        android:textColor="@color/viewTextColor"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swtEnableTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_gravity="center"
                        android:checked="false"
                        android:onCheckedChanged="@{(button, bool)-> createTaxFragment.enableTax(bool)}"
                        android:padding="@dimen/_5sdp"
                        app:srcCompat="@drawable/ic_arrow_forward"
                        app:theme="@style/AppTheme" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view" />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/edt_border_light_gray"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/CustomFontSemiBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/tax_name"
                            android:textColor="@color/viewTextColor"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etName"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"

                            android:gravity="end"
                            android:digits="@string/disable_emoji_string"
                            android:hint="Sales Tax"
                            android:imeOptions="actionNext"
                            android:inputType="textVisiblePassword"
                            android:paddingStart="@dimen/_20sdp"
                            android:paddingTop="@dimen/_5sdp"
                            android:paddingEnd="@dimen/_20sdp"
                            android:paddingBottom="@dimen/_5sdp"
                            android:text="@={viewModel.createTaxDetails.name}"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hintColor"
                            android:textSize="@dimen/_5mdpi" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/view" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/CustomFontSemiBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/tax_rate"
                            android:textColor="@color/viewTextColor"
                            android:textSize="@dimen/_5mdpi" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:padding="@dimen/_5sdp">

                            <TextView
                                android:id="@+id/tvSymbolDollar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/_1sdp"
                                android:fontFamily="@font/sf_pro_display_semibold"
                                android:text="@string/symbole"
                                android:textColor="@color/viewTextColor"
                                android:textSize="@dimen/_5mdpi"
                                android:visibility="gone" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/edtAmount"
                                style="@style/CustomFontSemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="end"
                                android:digits="0123456789"
                                android:hint="0.00"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:text="@={``+ viewModel.createTaxDetails.rate}"
                                android:textColor="@color/black"
                                android:textColorHint="@color/hintColor"
                                android:textSize="@dimen/_5mdpi" />

                            <TextView
                                android:id="@+id/tvSymbolPer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_1sdp"
                                android:fontFamily="@font/sf_pro_display_semibold"
                                android:text="@string/percentage_symbol"
                                android:textColor="@color/viewTextColor"
                                android:textSize="@dimen/_5mdpi"
                                android:visibility="gone" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swtTaxType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="center"
                            android:checked="true"
                            android:onCheckedChanged="@{(button, bool)-> createTaxFragment.taxType(bool)}"
                            android:padding="@dimen/_5sdp"
                            android:text="Percentage"
                            android:textSize="@dimen/_5mdpi"
                            app:theme="@style/AppTheme" />

                    </androidx.appcompat.widget.LinearLayoutCompat>


                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@color/view" />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llItemPricing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:elevation="@dimen/_10sdp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/item_pricing"
                        android:textColor="@color/viewTextColor"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvItemPricing"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/cool_grey"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:srcCompat="@drawable/ic_arrow_forward" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view" />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:elevation="@dimen/_10sdp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/tv_apply_tax_to"
                        android:textColor="@color/viewTextColor"
                        android:textSize="@dimen/_5mdpi" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:elevation="@dimen/_10sdp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/tv_custom_amount"
                        android:textColor="@color/viewTextColor"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swtCustomAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_gravity="center"
                        android:checked="false"
                        android:onCheckedChanged="@{(button, bool)-> createTaxFragment.customAmount(bool)}"
                        android:padding="@dimen/_5sdp"
                        app:theme="@style/AppTheme" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llAllItemsDialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:elevation="@dimen/_10sdp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/tv_items"
                        android:textColor="@color/viewTextColor"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/itemsCount"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textColor="@color/cool_grey"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:srcCompat="@drawable/ic_arrow_forward" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view" />


            </androidx.appcompat.widget.LinearLayoutCompat>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>