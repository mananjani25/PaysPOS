<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainCartLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backgroundColor"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color13"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtCustomerName"
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLength="40"
                android:paddingVertical="@dimen/_5sdp"
                android:singleLine="true"
                android:textColor="@color/btnColorDark"
                android:textSize="@dimen/_8mdpi"
                android:textStyle="bold"
                tools:text="Customer Name" />

            <TextView
                android:id="@+id/txtLoyaltyPointsLabel"
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLength="40"
                android:paddingVertical="@dimen/_5sdp"
                android:singleLine="true"
                android:textColor="@color/btnColorDark"
                android:textSize="@dimen/_8mdpi"
                android:textStyle="bold"
                tools:text="Loyalty Points: 1000" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/backgroundColor"
            android:orientation="horizontal"
            android:padding="@dimen/_5sdp"
            app:layout_constraintTop_toBottomOf="@id/topLayout">

            <TextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="Item Name"
                android:textColor="@color/white"
                android:textSize="@dimen/_6mdpi" />

            <TextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_weight="0.5"
                android:gravity="center"
                android:text="Qty"
                android:textColor="@color/white"
                android:textSize="@dimen/_6mdpi" />

            <TextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Each"
                android:textColor="@color/white"
                android:textSize="@dimen/_6mdpi" />

            <TextView
                style="@style/CustomFontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_weight="0.7"
                android:gravity="end"
                android:text="Total"
                android:textColor="@color/white"
                android:textSize="@dimen/_6mdpi" />


        </LinearLayout>

        <include
            android:id="@+id/dividerView"
            layout="@layout/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/rowHeaderLayout" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCartList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:nestedScrollingEnabled="true"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/linearBottom"
            app:layout_constraintTop_toBottomOf="@id/dividerView"
            tools:itemCount="5"
            tools:listitem="@layout/view_item_cart" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="#1d1d1f"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/liinear_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_60sdp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:id="@+id/relative_order_notes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:orientation="horizontal"
                                android:padding="@dimen/_1sdp"
                                android:visibility="gone">

                                <androidx.appcompat.widget.AppCompatTextView
                                    style="@style/CustomFontMediumStyle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_3sdp"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:text="@string/note"
                                    android:textColor="@color/dark_gray"
                                    android:textSize="@dimen/_6mdpi" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/txt_order_note"
                                    style="@style/CustomFontBold"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginEnd="@dimen/_3sdp"
                                    android:layout_weight="5"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:maxLines="2"
                                    android:singleLine="false"
                                    android:text=""
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_medium" />
                            </androidx.appcompat.widget.LinearLayoutCompat>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:orientation="horizontal"
                                android:padding="@dimen/_1sdp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    style="@style/CustomFontMediumStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_marginStart="@dimen/_3sdp"
                                    android:text="@string/payment_subtotal"
                                    android:textColor="@color/dark_gray"
                                    android:textSize="@dimen/_6mdpi"
                                    tools:ignore="RelativeOverlap" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/txtSubTotal"
                                    style="@style/CustomFontSemiBold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_gravity="end"
                                    android:layout_marginEnd="@dimen/_3sdp"
                                    android:gravity="end"
                                    android:text="@string/_0_00"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_medium" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:orientation="horizontal"
                                android:padding="@dimen/_1sdp">

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:id="@+id/linear_tax_detail"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <androidx.appcompat.widget.AppCompatTextView
                                        style="@style/CustomFontMediumStyle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="@dimen/_10sdp"
                                        android:layout_marginStart="@dimen/_3sdp"
                                        android:text="@string/tv_tax"
                                        android:textColor="@color/dark_gray"
                                        android:textSize="@dimen/_6mdpi" />

                                    <ImageView
                                        android:id="@+id/img_dropdown"
                                        android:layout_width="@dimen/_10sdp"
                                        android:layout_height="@dimen/_10sdp"
                                        android:src="@drawable/ic_arrow_drop_down"
                                        app:tint="@color/white" />
                                </androidx.appcompat.widget.LinearLayoutCompat>


                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/txtTax"
                                    style="@style/CustomFontSemiBold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_gravity="end"
                                    android:layout_marginEnd="@dimen/_3sdp"
                                    android:gravity="end"
                                    android:text="@string/_0_00"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_medium" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/relative_dynamic_tax"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:layout_marginBottom="@dimen/_1sdp"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_tax"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                    tools:itemCount="3" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:layout_marginBottom="@dimen/_1sdp"
                                android:orientation="horizontal"
                                android:padding="@dimen/_1sdp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    style="@style/CustomFontMediumStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_marginStart="@dimen/_3sdp"
                                    android:text="@string/service_charge"
                                    android:textColor="@color/dark_gray"
                                    android:textSize="@dimen/_6mdpi" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/txtServiceCharge"
                                    style="@style/CustomFontSemiBold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginEnd="@dimen/_3sdp"
                                    android:gravity="end"
                                    android:text="@string/_0_00"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_medium" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/tipLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:layout_marginBottom="@dimen/_1sdp"
                                android:orientation="horizontal"
                                android:padding="@dimen/_1sdp"
                                android:visibility="gone">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tipPercentLabel"
                                    style="@style/CustomFontMediumStyle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_marginStart="@dimen/_3sdp"
                                    android:text="Tip (%)"
                                    android:textColor="@color/dark_gray"
                                    android:textSize="@dimen/_6mdpi" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/txtTipGiven"
                                    style="@style/CustomFontSemiBold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginEnd="@dimen/_3sdp"
                                    android:gravity="end"
                                    android:text="@string/_0_00"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_medium" />
                            </RelativeLayout>


                        </LinearLayout>
                    </ScrollView>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:background="@color/grayBackgroundColor" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:orientation="horizontal"
                            android:padding="@dimen/_1sdp">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/CustomFontMediumStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:text="Discount"
                                android:textColor="@color/dark_gray"
                                android:textSize="@dimen/_6mdpi" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtDiscount"
                                style="@style/CustomFontSemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:gravity="end"
                                android:text="-$0.00"
                                android:textColor="@color/colorRed"
                                android:textSize="@dimen/text_size_medium" />
                        </RelativeLayout>


                        <RelativeLayout
                            android:id="@+id/linear_cash_Discount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:orientation="horizontal"
                            android:padding="@dimen/_1sdp"
                            android:visibility="gone">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/label_cashSurcharge"
                                style="@style/CustomFontMediumStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:textColor="@color/dark_gray"
                                android:textSize="@dimen/_6mdpi" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txt_noncashAdj"
                                style="@style/CustomFontSemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:gravity="end"
                                android:text="@string/_0_00"
                                android:textColor="@color/btnColorDark"
                                android:textSize="@dimen/text_size_medium" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/relative_loylatyPoints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <CheckBox
                                android:id="@+id/checkloylaty"
                                style="@style/CustomFontMediumStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layoutDirection="rtl"
                                android:text="@string/loyalty_rewards"
                                android:textColor="@color/dark_gray"
                                android:textSize="@dimen/_6mdpi"
                                android:visibility="visible" />


                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txt_label_loyaltyAmounts"
                                style="@style/CustomFontMediumStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:text="@string/loyalty_rewards"
                                android:textColor="@color/dark_gray"
                                android:textSize="@dimen/_6mdpi"
                                android:visibility="gone" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtLoyaltyAmount"
                                style="@style/CustomFontSemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_6sdp"
                                android:gravity="end"
                                android:text="@string/_0_00"
                                android:textColor="@color/btnColorDark"
                                android:textSize="@dimen/text_size_medium" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/lblLoyaltyPoints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:orientation="horizontal"
                            android:padding="@dimen/_1sdp"
                            android:visibility="gone">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/CustomFontMediumStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:text="@string/used_loyalty_points"
                                android:textColor="@color/dark_gray"
                                android:textSize="@dimen/_6mdpi" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtLoyaltyPoints"
                                style="@style/CustomFontSemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:gravity="end"
                                android:text="@string/_0_00"
                                android:textColor="@color/btnColorDark"
                                android:textSize="@dimen/text_size_medium" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"

                            android:orientation="horizontal"
                            android:padding="@dimen/_1sdp">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/CustomFontMediumStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:text="@string/tv_total"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_6mdpi" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtTotal"
                                style="@style/CustomFontBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:gravity="end"
                                android:text="@string/_0_00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_medium" />
                        </RelativeLayout>


                    </androidx.appcompat.widget.LinearLayoutCompat>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linear_button_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/tvSave"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:background="@color/backgroundColor"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/save"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_7mdpi" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPayNow"
                        style="@style/CustomFontBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:layout_weight="1"
                        android:background="@color/btnColorDark"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="Pay $0.00"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_7mdpi" />


                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/relPreoceedToFire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:background="@color/btnColorDark"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtDineInProceed"
                        style="@style/CustomFontBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="Proceed To Fire"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_7mdpi"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/imgFire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/txtDineInProceed"
                        android:src="@drawable/fire_active" />


                </RelativeLayout>


            </LinearLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1D1D1F"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="190dp"
            android:layout_height="100dp"
            android:src="@drawable/snacklogo_new"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="09:10 PM" />

        <TextView
            android:id="@+id/current_Date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="10dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/current_time"
            tools:text="Tuesday, 17 Jan" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/thankYouLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1D1D1F"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtPaidAmount"
            style="@style/CustomFontMediumStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_15sdp"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:textColor="@color/white"
            android:textSize="@dimen/_14mdpi"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/imageViewThankYou"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
