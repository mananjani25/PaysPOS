<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="model"
            type="com.android.pos.data.entities.TbItem" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="5">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="0.5"

                    android:gravity="center">

                    <CheckBox
                        android:id="@+id/chkIsFired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:gravity="center" />
                </LinearLayout>

                <View
                    android:id="@+id/viewLine"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/view" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/CustomFontBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:paddingStart="@dimen/_10sdp"
                        android:text="@{model.name}"
                        android:textColor="@color/drawerBack"
                        android:textSize="@dimen/_5mdpi"
                        tools:text="Item" />

                    <TextView
                        android:id="@+id/txtNote"
                        style="@style/CustomFontRegularStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingStart="@dimen/_10sdp"
                        android:singleLine="true"
                        android:text="@{@string/add_note_cart +``+model.note}"

                        android:textColor="@color/txtColor"
                        android:textSize="@dimen/_5mdpi" />
                </LinearLayout>

                <View
                    android:id="@+id/viewLine1"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/view"
                    app:layout_constraintTop_toBottomOf="@+id/linearHeader" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="0.5"
                    android:gravity="center">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/CustomFontSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@{`x `+model.itemQuantity}"
                        android:textColor="@color/color88"
                        android:textSize="@dimen/_5mdpi"
                        tools:text="x 10" />
                </LinearLayout>

                <View
                    android:id="@+id/viewLine3"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/view"
                    app:layout_constraintTop_toBottomOf="@+id/linearHeader" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/CustomFontBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:text="Vishal Patel"
                        android:textColor="@color/drawerBack"
                        android:textSize="@dimen/_5mdpi"
                        tools:text="Item" />
                </LinearLayout>

                <View
                    android:id="@+id/viewLine4"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/view"
                    app:layout_constraintTop_toBottomOf="@+id/linearHeader" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvRate"
                        style="@style/CustomFontBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="start"
                        android:textColor="@color/drawerBack"
                        android:textSize="@dimen/_5mdpi"
                        tools:text="$20.00" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDiscountRate"
                        style="@style/CustomFontBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:gravity="start"
                        android:textColor="@color/colorRed"
                        android:textSize="@dimen/_5mdpi"
                        tools:text="$20.00" />


                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvModifiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/view_cart_modifier" />

        <View
            android:id="@+id/viewLine5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/view"
            app:layout_constraintTop_toBottomOf="@+id/linearHeader" />

    </LinearLayout>


</layout>