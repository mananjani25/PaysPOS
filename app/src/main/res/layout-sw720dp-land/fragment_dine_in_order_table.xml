<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/linearHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtHome"
                style="@style/CustomFontBold"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_home_button"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/button_action_hover"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/padding_home_button"
                android:paddingVertical="@dimen/vertical_padding_home_button"
                android:text="Home"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_6mdpi" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtTitle"
                style="@style/CustomFontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Table Details"
                android:textColor="@color/white"
                android:textSize="@dimen/_6mdpi" />

            <ImageView
                android:id="@+id/imgPrintAll"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_12sdp"
                android:layout_toStartOf="@+id/txtHome"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_2sdp"
                android:src="@drawable/print_all"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/imgMergeTable"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_toStartOf="@+id/imgPrintAll"
                android:padding="@dimen/_2sdp"
                android:src="@drawable/ic_trans_table"
                android:visibility="gone"
                app:tint="@color/white" />

            <!-- <ImageView
                 android:id="@+id/imgTransferTable"
                 android:layout_width="@dimen/_17sdp"
                 android:layout_height="@dimen/_15sdp"
                 android:layout_centerVertical="true"
                 android:layout_marginEnd="@dimen/_8sdp"
                 android:layout_toStartOf="@+id/imgMergeTable"
                 android:padding="@dimen/_2sdp"
                 android:src="@drawable/merge"
                 app:tint="@color/white" />-->


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtFloorPlan"
                style="@style/CustomFontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:gravity="center"
                android:padding="@dimen/_6sdp"
                android:text="Floor Plan"
                android:textAllCaps="true"
                android:textColor="@color/btnColor"
                android:textSize="@dimen/_6mdpi" />


        </RelativeLayout>

        <View
            android:id="@+id/viewLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/view"
            app:layout_constraintTop_toBottomOf="@+id/linearHeader" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearHeaderNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dine_in_header_bg"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_3sdp"
            android:weightSum="10"
            app:layout_constraintTop_toBottomOf="@+id/viewLine">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1.2"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_2sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:text="Fire To Kitchen"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtGuestItemName"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="3"
                android:gravity="start"
                android:paddingStart="@dimen/_15sdp"
                android:text="Item Name"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtQuantity"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="Quantity"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtStaffName"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1.6"
                android:gravity="center"
                android:text="Employees"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtPriceLabel"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1.5"
                android:gravity="center"
                android:text="Price"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItemList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/footer"
            app:layout_constraintTop_toBottomOf="@+id/linearHeaderNew"
            app:layout_constraintVertical_bias="0"
            tools:listitem="@layout/view_dine_in_order_table" />

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/backgroundColor"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_2sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingEnd="@dimen/_2sdp"
            android:paddingBottom="@dimen/_4sdp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtHomeBottom"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_home_button"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_weight="1"
                android:background="@drawable/dine_in_footer_selector"
                android:gravity="center"
                android:visibility="gone"
                android:minWidth="@dimen/_120sdp"
                android:paddingHorizontal="@dimen/padding_home_button"
                android:paddingVertical="@dimen/vertical_padding_home_button"
                android:text="@string/tv_home"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtFireAll"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_weight="1"
                android:background="@drawable/dine_in_footer_selector"
                android:gravity="center"
                android:minWidth="@dimen/_120sdp"
                android:padding="@dimen/_8sdp"
                android:text="Fire"
                android:textColor="@color/white"
                android:textSize="@dimen/_6ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtEditOrder"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_weight="1"
                android:background="@drawable/dine_in_footer_selector"
                android:gravity="center"
                android:minWidth="@dimen/_120sdp"
                android:padding="@dimen/_8sdp"
                android:text="@string/edit_order"
                android:textColor="@color/white"
                android:textSize="@dimen/_6ssp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txt_addguest"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_weight="1"
                android:background="@drawable/dine_in_footer_selector"
                android:gravity="center"
                android:minWidth="@dimen/_120sdp"
                android:padding="@dimen/_8sdp"
                android:text="Add Guest"
                android:textColor="@color/white"
                android:textSize="@dimen/_6ssp" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/btnPayNew"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/btn_background_selector"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtPayNew"
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/pay_total"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_6ssp"
                    android:visibility="visible" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtTotalAmountNew"
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingStart="@dimen/_4sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:text="$0.00"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_6ssp" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llInfo1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="@dimen/_5sdp"
                        android:paddingEnd="@dimen/_5sdp"
                        android:tint="@color/white"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_info" />

                </androidx.appcompat.widget.LinearLayoutCompat>


            </androidx.appcompat.widget.LinearLayoutCompat>

        </LinearLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_5sdp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/rvItemList"
            app:layout_constraintStart_toStartOf="@+id/rvItemList">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/btnPay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_weight="0.45"
                android:background="@drawable/bg_button_border"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtPay"
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/pay_total"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_5mdpi" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtTotalAmount"
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_4sdp"
                    android:text="$0.00"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_7mdpi" />


            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/btnSendOrder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_weight="0.45"
                android:background="@drawable/bg_button_border"
                android:gravity="center">


                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_4sdp"
                    android:text="Send Order To Kitchen"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_7mdpi" />


            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llInfo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_5sdp"
                android:background="@drawable/background_button_menu"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_5sdp"
                    app:srcCompat="@drawable/ic_info" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>