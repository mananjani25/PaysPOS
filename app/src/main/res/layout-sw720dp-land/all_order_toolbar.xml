<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:gravity="center_vertical"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgDrawer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ic_baseline_menu" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_height="wrap_content">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_18sdp"
                app:tabBackground="@drawable/all_order_tab_bg_color_selector"
                app:tabIndicatorHeight="0dp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                app:tabMode="fixed"
                app:tabRippleColor="@color/btnColor"
                app:tabSelectedTextColor="@color/white"
                app:tabPaddingStart="@dimen/_10sdp"
                app:tabPaddingEnd="@dimen/_10sdp"
                app:tabTextColor="@color/white"
                app:tabTextAppearance="@style/OnlineOrderTabTextStyle" >

<!--                <com.google.android.material.tabs.TabItem-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:text="All Orders (50)"-->
<!--                    android:layout_height="wrap_content"/>-->

<!--                <com.google.android.material.tabs.TabItem-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:text="Open (10)"-->
<!--                    android:layout_height="wrap_content"/>-->

<!--                <com.google.android.material.tabs.TabItem-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:text="Phone (10)"-->
<!--                    android:layout_height="wrap_content"/>-->

<!--                <com.google.android.material.tabs.TabItem-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:text="Online (10)"-->
<!--                    android:layout_height="wrap_content"/>-->

<!--                <com.google.android.material.tabs.TabItem-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:text="3rd Party (10)"-->
<!--                    android:layout_height="wrap_content"/>-->

            </com.google.android.material.tabs.TabLayout>



            <LinearLayout
                android:id="@+id/linearSearchView"
                android:layout_width="wrap_content"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgSearch"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/autoSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@null"
                    android:digits="@string/character_digits_String"
                    android:maxLength="60"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:ellipsize="end"
                    android:hint="@string/search_by_order_id_employee_customer_name"
                    android:imeOptions="actionDone"
                    android:inputType="textVisiblePassword"
                    android:singleLine="true"
                    android:textColor="@color/txtColor"
                    android:textColorHint="@color/hint_color"
                    android:textSize="@dimen/_6mdpi"
                    tools:ignore="Autofill" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/txtHome"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/button_action_hover"
            android:gravity="center"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:paddingHorizontal="@dimen/padding_home_button"
            android:paddingVertical="@dimen/_6sdp"
            android:text="@string/tv_home"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/_7mdpi"/>

    </LinearLayout>


</LinearLayout>