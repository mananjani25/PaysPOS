<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="model"
            type="com.android.pos.data.entities.Modifier" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_marginStart="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_2sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_1sdp"
        android:weightSum="11.3">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_weight="7"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="start"
            android:text="@{model.name}"
            android:textColor="@color/drawerBack"
            android:textSize="@dimen/_5mdpi"
            tools:text="Item" />


        <androidx.appcompat.widget.AppCompatTextView
            style="@style/CustomFontSemiBold"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@{`x `+model.itemQuantity}"
            android:textColor="@color/color88"
            android:textSize="@dimen/_5mdpi"
            tools:text="x 10"
            android:gravity="end"
            android:layout_marginHorizontal="@dimen/_2sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvRate"
            style="@style/CustomFontSemiBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="end"
            android:layout_weight="3"
            android:text="@{@string/symbole +``+String.format(@string/format,(model.price * model.itemQuantity))}"
            android:textColor="@color/drawerBack"
            android:textSize="@dimen/_5mdpi"
            tools:text="$20.00"
            android:layout_marginHorizontal="@dimen/_2sdp"/>

    </androidx.appcompat.widget.LinearLayoutCompat>


</layout>