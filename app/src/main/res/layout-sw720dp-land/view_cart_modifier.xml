<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="model"
            type="com.android.pos.data.entities.Modifier" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"
        android:paddingStart="@dimen/_6sdp"
        android:paddingTop="@dimen/_2sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingBottom="@dimen/_2sdp"
        android:weightSum="3.7">

        <TextView
            android:id="@+id/txtName"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@{model.name}"
            android:textColor="@color/color88"
            android:textSize="@dimen/_5mdpi" />

        <TextView
            android:id="@+id/txtQuantity"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_weight="0.5"
            android:gravity="start"
            android:text="@{`x `+model.itemQuantity}"
            android:textColor="@color/color88"
            android:textSize="@dimen/_5mdpi" />

        <TextView
            android:id="@+id/txtEachQntPrice"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_weight="0.5"
            android:gravity="end"

            android:text="Each"
            android:textColor="@color/color88"
            android:textSize="@dimen/_4mdpi"
            android:visibility="invisible" />


        <TextView
            android:id="@+id/tvRate"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_weight="0.7"
            android:gravity="end"
            android:text="@{@string/symbole +``+String.format(@string/format,(model.price * model.itemQuantity))}"
            android:textColor="@color/color88"
            android:textSize="@dimen/_5mdpi" />


    </LinearLayout>
