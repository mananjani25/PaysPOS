<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.pays.pos.data.entities.TbItem" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_10mdpi"
        android:background="@drawable/myrect"
        android:elevation="@dimen/_5sdp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtTitle"
            style="@style/CustomFontMediumStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#969AA3"
            android:gravity="center"
            android:maxLength="2"
            android:paddingVertical="@dimen/_12sdp"
            android:paddingStart="@dimen/_15sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:text="@{viewModel.name}"
            android:textColor="#F4F3F8"
            android:textSize="@dimen/_6mdpi"
            android:visibility="@{viewModel.imageUrl == null ? View.VISIBLE : View.INVISIBLE}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textAllCaps="true"
            tools:text="TP" />

        <ImageView
            android:id="@+id/imgCategory"
            profileImage="@{viewModel.imageUrl != null ? viewModel.imageUrl : null}"
            thumbHolder="@{viewModel.thumbImageUrl != null ? viewModel.thumbImageUrl : null}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:visibility="@{viewModel.imageUrl != null ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="@+id/txtTitle"
            app:layout_constraintEnd_toEndOf="@+id/txtTitle"
            app:layout_constraintStart_toStartOf="@+id/txtTitle"
            app:layout_constraintTop_toTopOf="@+id/txtTitle" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/backgroundColor"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_3sdp"
            android:paddingBottom="@dimen/_3sdp"
            app:layout_constraintEnd_toEndOf="@+id/txtTitle"
            app:layout_constraintStart_toStartOf="@+id/txtTitle"
            app:layout_constraintTop_toBottomOf="@+id/txtTitle">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="@{viewModel.name}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                tools:text="Tax rates can be applied to specific items and will be automatically calculated at purchase.Tax rates can be applied to specific items and will be automatically calculated at purchase. calculated calculated" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/_3sdp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="end"
                android:text="@{@string/symbole +``+String.format(@string/format,viewModel.price)}"
                android:textColor="@color/hint_color"
                android:textSize="@dimen/_5mdpi"
                tools:text="$10.00" />
            <!--android:text="@{Double.toString(viewModel.price)}"-->

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>