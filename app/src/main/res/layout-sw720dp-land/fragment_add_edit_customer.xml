                </LinearLayout>
-->

                <EditText
                    android:id="@+id/edtAddress2"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:enabled="false"
                    android:padding="@dimen/_5sdp"
                    android:text="United States"
                    android:textColor="@color/txt_color_blue"
                    android:textSize="@dimen/_5mdpi"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/edtStreet2"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:enabled="false"
                    android:padding="@dimen/_5sdp"
                    android:text="Street"
                    android:textColor="@color/hintColor"
                    android:textSize="@dimen/_5mdpi"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/edtSuite2"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:enabled="false"
                    android:padding="@dimen/_5sdp"
                    android:text="Apt/Suite"
                    android:textColor="@color/hintColor"
                    android:textSize="@dimen/_5mdpi"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="3">


                    <EditText
                        android:id="@+id/edtCity2"
                        style="@style/CustomFontMediumStyle"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/background_square_border_grey"
                        android:enabled="false"
                        android:hint="City"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/hintColor"
                        android:textSize="@dimen/_5mdpi" />

                    <EditText
                        android:id="@+id/edtState2"
                        style="@style/CustomFontMediumStyle"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/background_square_border_grey"
                        android:enabled="false"
                        android:padding="@dimen/_5sdp"
                        android:text="State"
                        android:textColor="@color/hintColor"
                        android:textSize="@dimen/_5mdpi" />

                    <EditText
                        android:id="@+id/edtZip2"
                        style="@style/CustomFontMediumStyle"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/background_square_border_grey"
                        android:enabled="false"
                        android:padding="@dimen/_5sdp"
                        android:text="Zip"
                        android:textColor="@color/hintColor"
                        android:textSize="@dimen/_5mdpi" />


                </LinearLayout>


                <TextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="Company"
                    android:textColor="@color/color65"
                    android:textSize="@dimen/_5mdpi" />

                <EditText
                    android:id="@+id/edtCompany"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:padding="@dimen/_5sdp"
                    android:text="@={viewModel.addCustomerDetails.data.company}"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_5mdpi" />

                <TextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/tv_birthday_"
                    android:textColor="@color/color65"
                    android:textSize="@dimen/_5mdpi" />

                <TextView
                    android:id="@+id/edtBirthDay"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginBottom="@dimen/_15sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:clickable="true"
                    android:padding="@dimen/_5sdp"
                    android:text=""
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_5mdpi" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>