<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <import type="java.util.Locale" />
        <import type="java.text.NumberFormat" />

        <variable
            name="viewModel"
            type="com.pays.pos.ui.fragments.cashlog.CashLogViewModel" />

        <variable
            name="cashLogModel"
            type="com.pays.pos.data.model.responseModel.CashLogResponse.Data" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_10sdp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imgDrawer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_baseline_menu" />




            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtTitle"
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_3sdp"
                android:text="Cash Log"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_7mdpi" />


            <TextView
                android:id="@+id/txtEmail"
                style="@style/CustomFontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10sdp"
                android:padding="@dimen/_3sdp"
                android:text="@string/tv_email"
                android:textSize="@dimen/_7mdpi"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtHome"
                style="@style/CustomFontBold"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_home_button"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="@string/tv_home"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:textSize="@dimen/_7mdpi"
                android:background="@drawable/button_action_hover"
                android:paddingHorizontal="@dimen/padding_home_button"
                android:paddingVertical="@dimen/vertical_padding_home_button"
                android:visibility="visible" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="@color/view" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/_5sdp"
            android:gravity="start"
            android:orientation="horizontal"
            android:layout_marginHorizontal="@dimen/_5sdp"
            >

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:text="@string/start_date_amp_time"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/text_size_medium" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_22sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:onClick="@{() -> viewModel.datePicker(true)}"
                    android:orientation="horizontal"
                    android:padding="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    >

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:srcCompat="@drawable/ic_calendar"
                        tools:ignore="ContentDescription" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvStartDate"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@{viewModel.startDate}"
                        android:textColor="@color/txtColor"
                        android:textSize="@dimen/_5mdpi"
                        tools:text="2021-08-10" />
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/end_date_amp_time"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/text_size_medium" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_22sdp"
                    android:background="@drawable/background_square_border_grey"
                    android:onClick="@{() -> viewModel.datePicker(false)}"
                    android:orientation="horizontal"
                    android:padding="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_5sdp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_5sdp"
                        app:srcCompat="@drawable/ic_calendar"
                        tools:ignore="ContentDescription" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvEndDate"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@{viewModel.endDate}"
                        android:textColor="@color/txtColor"
                        android:textSize="@dimen/_5mdpi"
                        tools:text="2021-08-10" />
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="@drawable/background_square_border_grey"

                >


                <RelativeLayout
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:text="@string/all_terminals"
                        android:paddingLeft="@dimen/_3sdp"
                        android:textColor="@color/txtColor"
                        android:textSize="@dimen/_5mdpi"
                        android:visibility="gone"
                        />

                    <Spinner
                        android:id="@+id/spTerminals"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_gravity="center"
                        android:background="@null"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:overlapAnchor="false"
                        android:spinnerMode="dropdown"
                        android:textSize="@dimen/_5mdpi"
                        android:paddingEnd="@dimen/_10sdp"
                        tools:ignore="NestedWeights" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:paddingRight="@dimen/_3sdp"
                        android:layout_marginRight="@dimen/_3sdp"
                        app:srcCompat="@drawable/ic_down_solid_arrow_universal" />
                </RelativeLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/background_square_border_grey"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_4sdp"
                android:paddingVertical="@dimen/_4sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingLeft="@dimen/_3sdp"
                    android:text="Cash Drawer AMT"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_5mdpi" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtCashDrawerAmount"
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@{@string/symbole+String.format(@string/format,cashLogModel.totalLeftAmountInDrawer)}"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_5mdpi"
                    tools:text="@string/_0_00" />


            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_4sdp"
                android:background="@drawable/background_square_border_grey"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_4sdp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Cash Out AMT"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_5mdpi"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txt"
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@{@string/symbole+String.format(@string/format,cashLogModel.totalCashOut)}"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_5mdpi"
                    tools:text="@string/_0_00"
                    />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_4sdp"
                android:background="@drawable/background_square_border_grey"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_4sdp"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Cash In AMT"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_5mdpi" />
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@{@string/symbole+String.format(@string/format,cashLogModel.totalCashIn)}"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_5mdpi"
                    tools:text="@string/_0_00" />
            </androidx.appcompat.widget.LinearLayoutCompat>



        </LinearLayout>




        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="@color/view"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/backgroundColor"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_7sdp"
            >


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:paddingLeft="@dimen/_30sdp"
                android:text="@string/tv_order_id"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi"
                android:textAllCaps="true"/>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@string/tv_date_time"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi"
                android:textAllCaps="true"/>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@string/tv_total_amount"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi"
                android:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@string/order_type_n_team_name"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi"
                android:textAllCaps="true" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@string/event_type"
                android:textColor="@color/white"
                android:visibility="gone"
                android:textSize="@dimen/text_size_medium" />


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@string/employee_name"
                android:textColor="@color/white"
                android:textSize="@dimen/_5mdpi"
                android:visibility="gone" />


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@string/tv_terminal_id"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="left"
                android:paddingLeft="@dimen/_30sdp"
                android:text="@string/reason"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi"
                android:textAllCaps="true" />

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="@color/view"/>
        <TextView
            android:id="@+id/txt_nodata"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6sdp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOpenOrder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/view_cash_log" />


    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>