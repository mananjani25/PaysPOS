<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <import type="android.view.View" />

        <variable
            name="model"
            type="com.pays.pos.data.model.CategoryTabModel" />
    </data>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:orientation="vertical">

        <TextView
            style="@style/CustomFontSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            tools:text="Name"
            android:paddingTop="@dimen/_5sdp"
            android:paddingStart="@dimen/_1sdp"
            android:paddingEnd="@dimen/_1sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:text="@{model.title}"
            android:textColor="@{model.isSelected ? @color/txt_color_blue : @color/txtColor}"
            android:textSize="@dimen/_5mdpi" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@color/txtColor"
            android:visibility="@{model.isSelected ? View.VISIBLE : View.GONE}" />

    </LinearLayout>
</layout>