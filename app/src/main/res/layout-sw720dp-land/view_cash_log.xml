<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.android.pos.data.model.responseModel.CashLogResponse.Data.Cashe" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtOrderId"
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginStart="@dimen/_5sdp"
                android:text="@string/tv_order_type"
                android:textColor="@color/btnColor"
                android:textSize="@dimen/_5mdpi" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtDateTime"
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{@string/symbole +``+String.format(@string/format,viewModel.amount)}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                tools:text="@string/tv_total_amount" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{viewModel.orderTypeName}"
                android:textColor="@color/btnColor"
                android:textSize="@dimen/_5mdpi"
                tools:text="@string/tv_order_type" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtEvent"
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/txtColor"
                android:textAllCaps="false"
                android:textSize="@dimen/_5mdpi"
                tools:text="@string/event_type" />


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                android:text="@{viewModel.employeeName}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                tools:text="@string/employee_name" />


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@{viewModel.terminalName}"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                tools:text="@string/tv_terminal_id" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txt_reason"
                style="@style/CustomFontMediumStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="center"
                android:text=""
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_5mdpi"
                tools:text="" />

        </LinearLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>