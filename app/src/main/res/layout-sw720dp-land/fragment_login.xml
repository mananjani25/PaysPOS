<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="loginViewModel"
            type="com.android.pos.ui.fragments.loginscreen.LoginViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical">


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_pos"
                android:textColor="@color/black"
                android:textSize="@dimen/_16mdpi"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontMediumStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_10sdp"
                android:padding="@dimen/_5sdp"
                android:text="@string/tv_Info"
                android:textColor="@color/black"
                android:textSize="@dimen/_7mdpi" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/edt_border_light_gray"
                android:minWidth="@dimen/_200sdp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:hint="@string/tv_hint_email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:padding="@dimen/_5sdp"
                    android:text="@={loginViewModel.loginDetails.emailAddress}"
                    android:textColor="@color/black"
                    android:textColorHint="@color/hint_color_"
                    android:textSize="@dimen/_6mdpi" />

                <View
                    android:layout_width="@dimen/_200sdp"
                    android:layout_height="1dp"
                    android:background="@color/view" />


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edtPassword"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_toStartOf="@+id/txtForgotPass"
                        android:background="@null"
                        android:hint="@string/tv_hint_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:padding="@dimen/_5sdp"
                        android:text="@={loginViewModel.loginDetails.password}"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hint_color_"
                        android:textSize="@dimen/_6mdpi" />

                    <TextView
                        android:id="@+id/txtForgotPass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:fontFamily="@font/sf_pro_display_medium"
                        android:text="@string/forgot_password"
                        android:textColor="@color/txt_color_blue"
                        android:textSize="@dimen/_6mdpi" />
                </RelativeLayout>


            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtSignIn"
                style="@style/CustomFontSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_button_border"
                android:gravity="center"
                android:minWidth="@dimen/_200sdp"
                android:onClick="@{() -> loginViewModel.submit()}"
                android:padding="@dimen/_5sdp"
                android:text="@string/tv_login"
                android:textColor="@color/white"
                android:textSize="@dimen/_6mdpi" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontRegularStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_5sdp"
                android:visibility="invisible"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:text="@string/tv_info_provider"
                android:textColor="@color/gray_color"
                android:textSize="@dimen/_6mdpi" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/CustomFontMediumStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:gravity="bottom|center"
            android:padding="@dimen/_5sdp"
            android:text="@string/tv_pos_2021"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi" />
    </RelativeLayout>


</layout>