<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_color"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearFirst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:paddingVertical="@dimen/_2sdp">

            <ImageView
                android:id="@+id/imgDrawer"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingEnd="@dimen/_6sdp"
                android:paddingBottom="@dimen/_6sdp"
                android:src="@drawable/ic_menu_drawer" />


            <TextView
                android:id="@+id/txt_transaction"
                style="@style/CustomFontRegularStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_5sdp"
                android:text="@string/transactions"
                android:textAllCaps="true"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi" />


        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearSecond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/ll_home"
            android:paddingVertical="@dimen/_2sdp">

            <LinearLayout
                android:id="@+id/imgRefreshTables"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/_8sdp"
                android:visibility="gone">
            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_sync"
                android:tint="@color/txtColor"
                tools:ignore="UseAppTint" />
                <TextView
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/_2sdp"
                    android:text="Refresh"
                    android:textAllCaps="true"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_6mdpi"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/imgTransferTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:visibility="visible">

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/transfer_table_icon"
                android:tint="@color/txtColor"
                tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/CustomFontMediumStyle"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/_2sdp"
                    android:text="Transfer"
                    android:textAllCaps="true"
                    android:textColor="@color/txtColor"
                    android:textSize="@dimen/_6mdpi"/>
            </LinearLayout>
            <TextView
                android:id="@+id/txt_Dineinordere"
                style="@style/CustomFontSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/_10sdp"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_5sdp"
                android:text="dine in orders"
                android:textAllCaps="true"
                android:textColor="@color/btnColor"
                android:textSize="@dimen/_6mdpi"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_merge"
                style="@style/CustomFontMediumStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/_5sdp"
                android:text="merge"
                android:textAllCaps="true"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                android:drawablePadding="@dimen/_2sdp"
                android:drawableTint="@color/white"
                app:drawableLeftCompat="@drawable/merge_table" />


            <LinearLayout
                android:id="@+id/linear_switchUser"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@string/clock"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/_5sdp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgswitch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:contentDescription="@string/clock"
                    android:paddingVertical="@dimen/_5sdp"
                    android:src="@drawable/swipe_user_clock"
                    app:tint="@color/txtColor" />

                <TextView
                    android:id="@+id/txtUserName"
                    style="@style/CustomFontMediumStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/_100sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_gravity="center"
                    android:text="ELEANOR RUSSELL"
                    android:textSize="@dimen/_6mdpi" />
            </LinearLayout>

            <!--<View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:background="@color/txtColor" />

            <ImageView
                android:id="@+id/ivLock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_5sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_lock"
                app:tint="@color/txtColor" />-->


            <!--  <TextView
                android:id="@+id/txthome"
                style="@style/CustomFontRegularStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/button_action_hover"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:padding="@dimen/_5sdp"
                android:text="@string/tv_home"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />-->
        </androidx.appcompat.widget.LinearLayoutCompat>

        <LinearLayout
            android:id="@+id/ll_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:layout_alignBottom="@id/linearSecond"
            android:layout_alignParentEnd="true">
            <TextView
                android:id="@+id/txthome"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_home_button"
                android:layout_marginStart="@dimen/_5sdp"
                android:background="@color/btnColor"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingHorizontal="@dimen/padding_home_button"
                android:paddingVertical="@dimen/vertical_padding_home_button"
                android:text="@string/tv_home"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi" />
        </LinearLayout>



    </RelativeLayout>
</layout>