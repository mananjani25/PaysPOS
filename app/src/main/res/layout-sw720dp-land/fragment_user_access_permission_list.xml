        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"

            android:background="@color/view" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_50sdp"
            android:layout_marginEnd="@dimen/_50sdp"
            android:layout_marginBottom="@dimen/_5sdp"

            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtAddNewRole"
                style="@style/CustomFontBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@color/btnColor"
                android:gravity="center"
                android:paddingVertical="@dimen/_7sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                android:text="@string/tv_add_new_role"
                android:textColor="@color/white"
                android:textSize="@dimen/_7mdpi"
                app:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomFontSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:text="@string/tv_employee_role_list"
                android:textColor="@color/txtColor"
                android:textSize="@dimen/_6mdpi"
                app:textAllCaps="false" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserPermissionList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
