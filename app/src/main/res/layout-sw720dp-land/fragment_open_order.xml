<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/view_header_toolbar" />


        <include layout="@layout/divider" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtCustomerDetails"
                    style="@style/CustomFontBold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="@dimen/_8sdp"
                    android:text="@string/customer_details"
                    android:textAllCaps="true"
                    android:textColor="@color/txt_color_blue"
                    android:textSize="@dimen/_5mdpi" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDeliveryAddress"
                    style="@style/CustomFontBold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="@dimen/_8sdp"
                    android:text="@string/delivery_address"
                    android:textAllCaps="true"
                    android:textColor="@color/drawerBack50"
                    android:textSize="@dimen/_5mdpi" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtBillingAddress"
                    style="@style/CustomFontBold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="@dimen/_8sdp"
                    android:text="@string/billing_address"
                    android:textAllCaps="true"
                    android:textColor="@color/drawerBack50"
                    android:textSize="@dimen/_5mdpi" />
            </LinearLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_weight="1"
                    android:background="@color/txt_color_blue" />

                <View
                    android:id="@+id/viewDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_weight="1"
                    android:background="@color/view" />

                <View
                    android:id="@+id/viewBilling"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_weight="1"
                    android:background="@color/view" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <include layout="@layout/divider" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_35sdp"
            android:layout_marginEnd="@dimen/_35sdp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_search" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/etSearch"
                style="@style/CustomFontRegularStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:hint="@string/search_existing_customer_details"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/hintColor"
                android:textSize="@dimen/_5mdpi" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <include layout="@layout/divider" />

        <ScrollView
            android:id="@+id/scrollViewCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_35sdp"
                android:layout_marginEnd="@dimen/_35sdp"
                android:orientation="vertical">


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_5sdp"
                    android:visibility="visible">

                    <RadioGroup
                        android:id="@+id/rdGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <RadioButton
                            android:id="@+id/rdPickUp"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:button="@drawable/selector_size"
                            android:buttonTint="@color/kitchen_size_color_selector"
                            android:layoutDirection="rtl"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/pick_up"
                            android:textAlignment="textStart"
                            android:textSize="@dimen/_5mdpi" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/view" />


                        <RadioButton
                            android:id="@+id/rdDelivery"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:button="@drawable/selector_size"
                            android:buttonTint="@color/kitchen_size_color_selector"
                            android:layoutDirection="rtl"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/delivery"
                            android:textAlignment="textStart"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />


                    </RadioGroup>


                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/add_customer_details"
                        android:textColor="@color/viewTextColor"
                        android:textSize="@dimen/_6mdpi" />

                    <include layout="@layout/divider" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/edt_border_light_gray"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtFirstName"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/first_name"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                            android:digits="@string/character_String"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtLastName"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/last_name_"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi"
                            android:digits="@string/character_String"/>

                        <include layout="@layout/divider" />

                        <com.santalu.maskedittext.MaskEditText
                            android:id="@+id/edtPhoneNo"
                            style="@style/CustomFontMediumStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="@string/_201_555_0123"
                            android:inputType="number"
                            android:maxLength="20"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi"
                            app:met_mask="(###) ###-####" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtEmail"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/tv_hint_email_"
                            android:imeOptions="actionDone"
                            android:inputType="textEmailAddress"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtCompany"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/company"
                            android:imeOptions="actionDone"
                            android:inputType="textEmailAddress"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/edtDate"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/date"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <include layout="@layout/divider" />


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/edtTime"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@null"
                            android:hint="@string/time"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />


                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/CustomFontBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/note"
                        android:textColor="@color/viewTextColor"
                        android:textSize="@dimen/_6mdpi" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edtNote"
                        style="@style/CustomFontMediumStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:background="@drawable/edt_border_light_gray"
                        android:gravity="top"
                        android:hint="@string/add_note"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hintColor"
                        android:textSize="@dimen/_5mdpi" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnClearCustomer"
                        style="@style/CustomFontBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_border_gray"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/clear"
                        android:textColor="@color/btnColor"
                        android:textSize="@dimen/_5mdpi"
                        app:textAllCaps="false" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnCancelCustomer"
                        style="@style/CustomFontBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_border_gray"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/tv_cancel"
                        android:textColor="@color/btnColor"
                        android:textSize="@dimen/_5mdpi"
                        android:visibility="visible"
                        app:textAllCaps="false" />

                </androidx.appcompat.widget.LinearLayoutCompat>


            </androidx.appcompat.widget.LinearLayoutCompat>

        </ScrollView>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_35sdp"
            android:layout_marginEnd="@dimen/_35sdp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@color/view" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/same_as_billing_address"
                    android:textColor="@color/viewTextColor"
                    android:textSize="@dimen/_5mdpi" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swtOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="center"
                    android:checked="true"
                    android:padding="@dimen/_5sdp"
                    app:srcCompat="@drawable/ic_arrow_forward"
                    app:theme="@style/AppTheme" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <include layout="@layout/divider" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical">

                <TextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/customer_address"
                    android:textColor="@color/viewTextColor"
                    android:textSize="@dimen/_6mdpi" />

                <include layout="@layout/divider" />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="vertical">

                    <Spinner
                        android:id="@+id/spDelivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/background_square_border_grey"
                        android:theme="@style/SpinnerTheme" />

                    <AutoCompleteTextView
                        android:id="@+id/edtStreet"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_square_border_grey"
                        android:hint="@string/street"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/txtColor"
                        android:textColorHint="@color/hint_color_"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edtSuite"
                        style="@style/CustomFontMediumStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_square_border_grey"
                        android:hint="@string/apt_suite"
                        android:inputType="textNoSuggestions"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/txtColor"
                        android:textColorHint="@color/hint_color_"
                        android:textSize="@dimen/_5mdpi" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtCity"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/city"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtState"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/state"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtZip"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/zip"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />


                    </LinearLayout>


                </androidx.appcompat.widget.LinearLayoutCompat>


            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnClearDelivery"
                    style="@style/CustomFontBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_border_gray"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/clear"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_5mdpi"
                    app:textAllCaps="false" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnCancelDelivery"
                    style="@style/CustomFontBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_border_gray"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/tv_cancel"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_5mdpi"
                    android:visibility="visible"
                    app:textAllCaps="false" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llBillingAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_35sdp"
            android:layout_marginEnd="@dimen/_35sdp"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="vertical">

                <TextView
                    style="@style/CustomFontSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/billing_address"
                    android:textColor="@color/viewTextColor"
                    android:textSize="@dimen/_6mdpi" />

                <include layout="@layout/divider" />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="vertical">

                    <Spinner
                        android:id="@+id/spBill"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/background_square_border_grey"
                        android:theme="@style/SpinnerTheme" />

                    <AutoCompleteTextView
                        android:id="@+id/edtStreetBill"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_square_border_grey"
                        android:hint="@string/street"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:padding="@dimen/_5sdp"

                        android:textColor="@color/txtColor"
                        android:textColorHint="@color/hint_color_"
                        android:textSize="@dimen/_5mdpi" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edtSuiteBill"
                        style="@style/CustomFontSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_square_border_grey"
                        android:hint="@string/apt_suite"
                        android:inputType="textNoSuggestions"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/txtColor"
                        android:textColorHint="@color/hint_color_"
                        android:textSize="@dimen/_5mdpi" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtCityBill"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/city"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtStateBill"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/state"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/edtZipBill"
                            style="@style/CustomFontSemiBold"
                            android:layout_width="0sp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/background_square_border_grey"
                            android:hint="@string/zip"
                            android:inputType="textNoSuggestions"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/txtColor"
                            android:textColorHint="@color/hint_color_"
                            android:textSize="@dimen/_5mdpi" />


                    </LinearLayout>


                </androidx.appcompat.widget.LinearLayoutCompat>


            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnClearBill"
                    style="@style/CustomFontBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_border_gray"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/clear"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_5mdpi"
                    app:textAllCaps="false" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnCancelBill"
                    style="@style/CustomFontBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_border_gray"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/tv_cancel"
                    android:textColor="@color/btnColor"
                    android:textSize="@dimen/_5mdpi"
                    android:visibility="visible"
                    app:textAllCaps="false" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>