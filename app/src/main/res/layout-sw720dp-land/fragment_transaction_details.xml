                            android:text="@{@string/symbole +``+String.format(@string/format,orderDetails.data.order.refund_detail.refunded_amount)}"
                            android:textColor="@color/colorRed"
                            android:textSize="@dimen/_5mdpi" />
                    </LinearLayout>


                </LinearLayout>
