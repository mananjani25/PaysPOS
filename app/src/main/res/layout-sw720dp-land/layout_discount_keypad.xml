<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    android:gravity="center"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvOne"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonOne"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
           />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTwo"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonTwo"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginLeft="@dimen/_5sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvThree"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonThree"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginHorizontal="@dimen/_5sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txt10"
            style="@style/CustomFontBold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/_23sdp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="center"
            android:background="@color/btnColor"
            android:gravity="center"
            android:text="10%"
            android:textColor="@color/white"
            android:textSize="@dimen/_7mdpi"
           />

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFour"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonFour"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFive"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonFive"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginLeft="@dimen/_5sdp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSix"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonSix"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginHorizontal="@dimen/_5sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/CustomFontBold"
            android:id="@+id/txt20"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/_23sdp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="center"
            android:background="@color/btnColor"
            android:gravity="center"
            android:text="20%"
            android:textColor="@color/white"
            android:textSize="@dimen/_7mdpi"
            />

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSeven"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonSeven"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEight"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonEight"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginLeft="@dimen/_5sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNine"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/buttonNine"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginHorizontal="@dimen/_5sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/CustomFontBold"
            android:id="@+id/txt30"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/_23sdp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="center"
            android:background="@color/btnColor"
            android:gravity="center"
            android:text="30%"
            android:textColor="@color/white"
            android:textSize="@dimen/_7mdpi"
            />


    </LinearLayout>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center"
        android:orientation="horizontal">


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtClear"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="@string/clear"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            />



        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvZero"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="0"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginLeft="@dimen/_5sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDZero"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:text="00"
            android:textColor="@color/txtColor"
            android:textSize="@dimen/_6mdpi"
            android:layout_marginLeft="@dimen/_5sdp"/>


        <ImageView
            android:id="@+id/tvClear"
            style="@style/CustomFontRegularStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/_23sdp"
            android:layout_weight="1"
            android:background="@drawable/background_txt_selector"
            android:padding="@dimen/_7sdp"

            android:src="@drawable/backspase"
            android:layout_marginLeft="@dimen/_5sdp"
            app:tint="@color/txtColor" />
    </LinearLayout>

</LinearLayout>
